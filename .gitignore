# ============================
# SQLFlow - Root .gitignore
# ============================

# --- Python / Backend ---
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
backend/.env
backend/*.egg-info/
backend/.pytest_cache/
backend/.mypy_cache/
*.log

# --- Node / Frontend ---
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/.env.production

# --- OS and Editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# --- Misc ---
*.zip
*.tar.gz
